# Twitch developer application credentials (required for live-status checks)
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret

# API key database and secure browser-session cookie
TWITCH_M3U_AUTH_DB=data/auth.sqlite3
TWITCH_M3U_COOKIE_SECURE=true
TWITCH_M3U_LOGIN_USERNAME=admin
TWITCH_M3U_LOGIN_PASSWORD=replace-with-a-strong-password-at-least-12-chars

# Optional host port for Docker Compose (defaults to 8000)
PORT=8000
