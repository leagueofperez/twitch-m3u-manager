# Twitch developer application credentials (required for live-status checks)
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret

# API key database and secure browser-session cookie
TWITCH_M3U_AUTH_DB=data/auth.sqlite3
TWITCH_M3U_COOKIE_SECURE=true
# Optional in local development; set to your public HTTPS origin in production.
# TWITCH_M3U_PUBLIC_ORIGIN=https://your-domain.example
# Optional: set this to your real X/Twitter account, including the @.
# TWITCH_M3U_TWITTER_HANDLE=@youraccount
TWITCH_M3U_LOGIN_USERNAME=admin
TWITCH_M3U_LOGIN_PASSWORD=replace-with-a-strong-password-at-least-12-chars

# Optional host port for Docker Compose (defaults to 8000)
PORT=8000

# Trusted reverse-proxy IPs/CIDRs for X-Forwarded-Proto (comma-separated)
# Set to the proxy's address, not "*" when the app is directly reachable.
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional Twitch Stream Extractor configuration
PUBLIC_URL=
SHORT_IO_API_KEY=
SHORT_IO_DOMAIN=
EXTRACTOR_WORKERS=2
MAX_CONTENT_LENGTH=16384
